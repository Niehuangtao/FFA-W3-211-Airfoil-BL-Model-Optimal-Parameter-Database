\pard\f0\fs15     % plot(rad2deg(a(idx_s:idx_l)), CM(idx_s:idx_l), a0,cm,rad2deg(a_init(idx_s:idx_l)),CM_init(idx_s:idx_l),'LineWidth',1.5);\par
\pard\f0\fs15     % xlabel('\u25915?\u-30254? \u945? (\u176?)','FontSize',15);\par
\pard\f0\fs15     % ylabel('\u21147?\u30697?\u31995?\u25968? C_M','FontSize',15);\par
\pard\f0\fs15     % title('BL\u27169?\u22411?cm\u31995?\u25968?','FontSize',15); grid on;\par
\pard\f0\fs15     % legend('\u20248?\u21270?\u21518?','\u21319?\u-27077?\u21147?\u25968?\u25454?','\u21407?BL','Location','northwest')\par
\pard\f0\fs15     % saveas(gcf, ['cm_compare','.png']);\par
\pard\f0\fs15     % exportgraphics(gcf,'cm_compare.pdf','ContentType', 'vector')\par
\pard\f0\fs15     init_data = [rad2deg(a_init(idx_s:idx_l))',CN_init(idx_s:idx_l)];\par
\pard\f0\fs15     exp_data  = [a0,cl];\par
\pard\f0\fs15     GZ_data  = [rad2deg(a(idx_s:idx_l))',CN_total(idx_s:idx_l)];\par
\pard\f0\fs15     save('data_collection_lag.mat', 'init_data', 'exp_data', 'GZ_data');\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/dataprocess_GZ.m =====\par
\pard\f0\fs15 function Error_GZ = dataprocess_GZ(ARE_data,DTW_data,GZ_data,init_data,exp_data)\par
\pard\f0\fs15     ARE_GZ  = area_overlap_GZ(ARE_data(:,1)' ,ARE_data(:,2),exp_data(:,1),exp_data(:,2));\par
\pard\f0\fs15     DTW_GZ  = area_overlap_GZ(DTW_data(:,1)' ,DTW_data(:,2),exp_data(:,1),exp_data(:,2));\par
\pard\f0\fs15     GZ_GZ   = area_overlap_GZ(GZ_data(:,1)'  ,GZ_data(:,2) ,exp_data(:,1),exp_data(:,2));\par
\pard\f0\fs15     init_GZ = area_overlap_GZ(init_data(:,1)',init_data(:,2),exp_data(:,1),exp_data(:,2));\par
\pard\f0\fs15     area_exp = polyshape(exp_data(:,1),exp_data(:,2));\par
\pard\f0\fs15     S_exp = area(area_exp);\par
\pard\f0\fs15     Error_GZ = [ARE_GZ/S_exp DTW_GZ/S_exp GZ_GZ/S_exp];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/draw_group.m =====\par
\pard\f0\fs15 function draw_group(ax, xrange, yline, txt, ytxt)\par
\pard\f0\fs15     plot(ax, xrange, [yline yline], 'k', 'LineWidth', 1.2, 'Clipping', 'off');\par
\pard\f0\fs15     text(ax, mean(xrange), ytxt, txt, ...\par
\pard\f0\fs15         'HorizontalAlignment', 'center', ...\par
\pard\f0\fs15         'VerticalAlignment', 'top', ...\par
\pard\f0\fs15         'FontSize', 30, 'Clipping', 'off', ...\par
\pard\f0\fs15         'Interpreter', 'latex', ...\par
\pard\f0\fs15         'FontName', 'Times New Roman');\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/drawCoffeint.m =====\par
\pard\f0\fs15 function [a, Coefficient] = drawCoffeint(filename,setcase)\par
\pard\f0\fs15     warning off\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions;\par
\pard\f0\fs15     %1.\u24037?\u20917?\u-29762?\u32622?\u-248?\u19982?\u20027?\u31243?\u24207?\u19968?\u-32268?\u-247?\par
\pard\f0\fs15     f     = conditions.ff ;\par
\pard\f0\fs15     w    = conditions.w;\par
\pard\f0\fs15     U    = conditions.U;\par
\pard\f0\fs15     c    = 1;\par
\pard\f0\fs15     T     = 1/f      ;\par
\pard\f0\fs15     data       = readoutfile(filename);\par
\pard\f0\fs15     coefficient   = data(:,2)            ;\par
\pard\f0\fs15     time       = data(:,3)            ;\par
\pard\f0\fs15     timestep   = time(3)- time(2);\par
\pard\f0\fs15     %n = time(end,:) / T;\par
\pard\f0\fs15     a = 3;\par
\pard\f0\fs15     b = 4;\par
\pard\f0\fs15     t_i = a * T / timestep;\par
\pard\f0\fs15     t_j = b * T / timestep;\par
\pard\f0\fs15     [a,~,~,~] = get_a_q(meanangle,-averageangle,w,c,U,time(t_i:t_j));\par
\pard\f0\fs15     a = rad2deg(a);\par
\pard\f0\fs15     Coefficient = coefficient(t_i:t_j);\par
\pard\f0\fs15     % figure\par
\pard\f0\fs15     % plot(a(2:length(Coff1)),Coff1(2:length(Coff1)),'Color','b')\par
\pard\f0\fs15     % hold on\par
\pard\f0\fs15     % plot(a(length(Coff1)+1:end),Coff2(length(Coff1)+1:end),'Color','r')\par
\pard\f0\fs15     % title(['k = ' num2str(k)   '\u26102?\u30340?' type '\u31995?\u25968?'])\par
\pard\f0\fs15     % ylabel(type)\par
\pard\f0\fs15     % xlabel('\u25915?\u-30254?/ \\alpha')\par
\pard\f0\fs15     % legend('\u25915?\u-30254?\u22686?\u22823?','\u25915?\u-30254?\u20943?\u23567?','Location','northwest')\par
\pard\f0\fs15     %\par
\pard\f0\fs15     % saveas(gcf, [filename,'.png']);\par
\pard\f0\fs15     % exportgraphics(gcf, [filename,'.pdf'], 'ContentType', 'vector');\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/find_a0.m =====\par
\pard\f0\fs15 function alpha0 = find_a0(data)\par
\pard\f0\fs15     cl_exp     = data(:,2);\par
\pard\f0\fs15     alpha_exp  = data(:,1)*pi/180;\par
\pard\f0\fs15     cl_sign = sign(cl_exp);\par
\pard\f0\fs15     cross_zero_idx = [];\par
\pard\f0\fs15     for i = 2:length(cl_exp)-1\par
\pard\f0\fs15         if cl_sign(i) * cl_sign(i+1) < 0\par
\pard\f0\fs15             cross_zero_idx = [cross_zero_idx, i];\par
\pard\f0\fs15         elseif cl_exp(i) == 0\par
\pard\f0\fs15             cross_zero_idx = [cross_zero_idx, i];\par
\pard\f0\fs15         end\par
\pard\f0\fs15     end\par
\pard\f0\fs15     alpha_CL0 = [];\par
\pard\f0\fs15     for idx = cross_zero_idx\par
\pard\f0\fs15         x1 = alpha_exp(idx);   y1 = cl_exp(idx);\par
\pard\f0\fs15         x2 = alpha_exp(idx+1); y2 = cl_exp(idx+1);\par
\pard\f0\fs15         alpha_0 = x1 - y1 * (x2 - x1) / (y2 - y1);\par
\pard\f0\fs15         alpha_CL0 = [alpha_CL0, alpha_0];\par
\pard\f0\fs15     end\par
\pard\f0\fs15     target = abs(alpha_CL0);\par
\pard\f0\fs15     idx    = target == min(abs(alpha_CL0));\par
\pard\f0\fs15     alpha0 = alpha_CL0(idx);\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/find_CD0.m =====\par
\pard\f0\fs15 function cd_at_CL0 = find_CD0(data)\par
\pard\f0\fs15     cl_exp     = data(:,2);\par
\pard\f0\fs15     alpha_exp_deg = data(:,1);\par
\pard\f0\fs15     alpha_exp_rad = alpha_exp_deg * pi/180;\par
\pard\f0\fs15     cd_exp     = data(:,3);\par
\pard\f0\fs15     valid_idx = ~isnan(cl_exp) & ~isnan(alpha_exp_deg) & ~isnan(cd_exp);\par
\pard\f0\fs15     cl_exp = cl_exp(valid_idx);\par
\pard\f0\fs15     alpha_exp_deg = alpha_exp_deg(valid_idx);\par
\pard\f0\fs15     alpha_exp_rad = alpha_exp_rad(valid_idx);\par
\pard\f0\fs15     cd_exp = cd_exp(valid_idx);\par
\pard\f0\fs15     cl_sign = sign(cl_exp);\par
\pard\f0\fs15     cross_zero_idx = [];\par
\pard\f0\fs15     n = length(cl_exp);\par
\pard\f0\fs15     for i = 2:n-1\par
\pard\f0\fs15         if cl_sign(i) * cl_sign(i+1) < 0\par
\pard\f0\fs15             cross_zero_idx = [cross_zero_idx, i];\par
\pard\f0\fs15         elseif cl_exp(i) == 0\par
\pard\f0\fs15             cross_zero_idx = [cross_zero_idx, i];\par
\pard\f0\fs15         end\par
\pard\f0\fs15     end\par
\pard\f0\fs15     alpha_CL0 = [];\par
\pard\f0\fs15     for idx = cross_zero_idx\par
\pard\f0\fs15         x1_rad = alpha_exp_rad(idx);   y1_cl = cl_exp(idx);\par
\pard\f0\fs15         x2_rad = alpha_exp_rad(idx+1); y2_cl = cl_exp(idx+1);\par
\pard\f0\fs15         alpha_0_rad = x1_rad - y1_cl * (x2_rad - x1_rad) / (y2_cl - y1_cl);\par
\pard\f0\fs15         alpha_CL0 = [alpha_CL0, alpha_0_rad];\par
\pard\f0\fs15     end\par
\pard\f0\fs15     target = abs(alpha_CL0);\par
\pard\f0\fs15     idx    = target == min(abs(alpha_CL0));\par
\pard\f0\fs15     alpha0 = alpha_CL0(idx);\par
\pard\f0\fs15     cd_at_CL0 = [];\par
\pard\f0\fs15     if ~isempty(alpha0)\par
\pard\f0\fs15         alpha_0_deg = alpha0 * 180/pi;\par
\pard\f0\fs15         cd_at_CL0 = interp1(alpha_exp_deg, cd_exp, alpha_0_deg, 'linear', 'extrap');\par
\pard\f0\fs15     end\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/fitness.m =====\par
\pard\f0\fs15 function Fitness = fitness(param,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, Cl_CFD,Cd_CFD,Cm_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7.5 * n_steps/10;\par
\pard\f0\fs15     last  = 8.5 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(meanangle-averageangle,meanangle+averageangle,1500);\par
\pard\f0\fs15     [S_Cl,RMSE_CL] = area_overlap(x_area,a_c,test_Cl,rad2deg(a0),Cl_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     [dist1,~,~] = dtw(Cl_CFD,test_Cl);\par
\pard\f0\fs15     [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = dist3;\par
\pard\f0\fs15 %% ===== File: functions/fitness_ARE.m =====\par
\pard\f0\fs15 function Fitness = fitness_ARE(param,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7* n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CN_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CN_CFD),length(CN_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CN_CFD),length(test_Cn));\par
\pard\f0\fs15     [~,ARE] = area_overlap_ARE(x_area,x_test,test_Cl,x_CFD,CN_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = ARE;\par
\pard\f0\fs15 %% ===== File: functions/fitness_cl.m =====\par
\pard\f0\fs15 function Fitness = fitness_cl(para_local_lag,para_init_cl,para_init_cm,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD,CD_CFD,CM_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     param = [para_local_lag para_init_cl para_init_cm];\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7* n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CN_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CN_CFD),length(CN_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CN_CFD),length(test_Cl));\par
\pard\f0\fs15     ARE = area_overlap_GZ(a_c',test_Cl,a0,CN_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     % [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = ARE;\par
\pard\f0\fs15 %% ===== File: functions/fitness_cm.m =====\par
\pard\f0\fs15 function Fitness = fitness_cm(para_local_lag,para_local_cl,para_init_cm,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD,CD_CFD,CM_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     param = [para_local_lag para_local_cl para_init_cm];\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7* n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CN_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CN_CFD),length(CN_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CN_CFD),length(test_Cl));\par
\pard\f0\fs15     ARE = area_overlap_GZ(a_c,test_Cm,a0,CM_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     % [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = ARE;\par
\pard\f0\fs15 %% ===== File: functions/fitness_constraint.m =====\par
\pard\f0\fs15 function [c, ceq] = fitness_constraint(param, initial_fitness,setcase)\par
\pard\f0\fs15     current_fitness = fitness(param,setcase);\par
\pard\f0\fs15     c = current_fitness - initial_fitness;\par
\pard\f0\fs15     ceq = [];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/fitness_constraint_cl.m =====\par
\pard\f0\fs15 function [c, ceq] = fitness_constraint_cl(para_local_lag,para_init_cl,para_init_cm, initial_fitness,setcase)\par
\pard\f0\fs15     current_fitness = fitness_lag(para_local_lag,para_init_cl,para_init_cm,setcase);\par
\pard\f0\fs15     c = current_fitness - initial_fitness;\par
\pard\f0\fs15     ceq = [];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/fitness_constraint_cm.m =====\par
\pard\f0\fs15 function [c, ceq] = fitness_constraint_cm(para_local_lag,para_local_cl,para_init_cm, initial_fitness,setcase)\par
\pard\f0\fs15     current_fitness = fitness_lag(para_local_lag,para_local_cl,para_init_cm,setcase);\par
\pard\f0\fs15     c = current_fitness - initial_fitness;\par
\pard\f0\fs15     ceq = [];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/fitness_constraint_GZ.m =====\par
\pard\f0\fs15 function [c, ceq] = fitness_constraint_GZ(para_init_lag,para_init_cl,para_init_cm, initial_fitness,setcase)\par
\pard\f0\fs15     current_fitness = fitness_GZ(para_init_lag,para_init_cl,para_init_cm,setcase);\par
\pard\f0\fs15     c = current_fitness - initial_fitness;\par
\pard\f0\fs15     ceq = [];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/fitness_constraint_lag.m =====\par
\pard\f0\fs15 function [c, ceq] = fitness_constraint_lag(para_init_lag,para_init_cl,para_init_cm, initial_fitness,setcase)\par
\pard\f0\fs15     current_fitness = fitness_lag(para_init_lag,para_init_cl,para_init_cm,setcase);\par
\pard\f0\fs15     c = current_fitness - initial_fitness;\par
\pard\f0\fs15     ceq = [];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/fitness_DTW.m =====\par
\pard\f0\fs15 function Fitness = fitness_DTW(param,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7* n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CN_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CN_CFD),length(CN_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CN_CFD),length(test_Cn));\par
\pard\f0\fs15     [S_Cl,RMSE_CL] = area_overlap_DTW(x_area,x_test,test_Cl,x_CFD,CN_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = RMSE_CL;\par
\pard\f0\fs15 %% ===== File: functions/fitness_GZ.m =====\par
\pard\f0\fs15 function Fitness = fitness_GZ(para_init_lag,para_init_cl,para_init_cm,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD,CD_CFD,CM_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     param = [para_init_lag para_init_cl para_init_cm];\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7* n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CM_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CM_CFD),length(CM_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CM_CFD),length(test_Cm));\par
\pard\f0\fs15     ARE = area_overlap_GZ(a_c,test_Cm,a0,CM_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     % [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = ARE;\par
\pard\f0\fs15 %% ===== File: functions/fitness_lag.m =====\par
\pard\f0\fs15 function Fitness = fitness_lag(para_init_lag,para_init_cl,para_init_cm,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD,CD_CFD,CM_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     param = [para_init_lag para_init_cl para_init_cm];\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7 * n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CN_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CN_CFD),length(CN_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CN_CFD),length(test_Cl));\par
\pard\f0\fs15     ARE = area_overlap_GZ(a_c',test_Cl,a0,CN_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     % [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = ARE;\par
\pard\f0\fs15 %% ===== File: functions/fitness_MSE.m =====\par
\pard\f0\fs15 function Fitness = fitness_MSE(param,setcase)\par
\pard\f0\fs15     meanangle = setcase.meanangle ;\par
\pard\f0\fs15     averageangle = setcase.averageangle ;\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, CN_CFD] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(param,conditions,airfoildata);\par
\pard\f0\fs15     % \u21462?BL\u27169?\u22411?\u26368?\u21518?5\u20010?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = conditions.n_steps;\par
\pard\f0\fs15     begin = 7* n_steps/10;\par
\pard\f0\fs15     last  = 8 * n_steps/10;\par
\pard\f0\fs15     test_Cl = CL(begin:last);\par
\pard\f0\fs15     test_Cd = CD(begin:last);\par
\pard\f0\fs15     test_Cm = CM(begin:last);\par
\pard\f0\fs15     test_Cn = CN_total(begin:last);\par
\pard\f0\fs15     a_c     = rad2deg(a(begin:last));\par
\pard\f0\fs15     %% ===================== 3. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?1\u-230?\u26354?\u32447?\u22260?\u25104?\u-26782?\u31215?\u30340?\u32477?\u23545?\u-29713?\u24046?=====================\par
\pard\f0\fs15     x_area = linspace(1,length(CN_CFD),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(CN_CFD),length(CN_CFD));\par
\pard\f0\fs15     x_test  = linspace(1,length(CN_CFD),length(test_Cn));\par
\pard\f0\fs15     [S_Cl,MSE] = area_overlap_MSE(x_area,x_test,test_Cl,x_CFD,CN_CFD);\par
\pard\f0\fs15     % [S_Cd,RMSE_CD] = area_overlap(x_area,a_c,test_Cd,rad2deg(a0),Cd_CFD);\par
\pard\f0\fs15     % [S_Cm,RMSE_CM]  = area_overlap(x_area,a_c,test_Cm,rad2deg(a0),Cm_CFD);\par
\pard\f0\fs15     % %Area_Err_Cm = abs(S_Cm_BL - S_Cm_CFD);\par
\pard\f0\fs15     % Total_RMSE = RMSE_CL+RMSE_CD;\par
\pard\f0\fs15     % Total_Area_overlap = S_Cl;\par
\pard\f0\fs15     %% ===================== 4. \u26680?\u24515?\u-29756?\u20215?\u25351?\u26631?2\u-230?\u-28656?\u28857?\u25311?\u21512?\u30340?\u22343?\u26041?\u26681?\u-29713?\u24046?(RMSE) =====================\par
\pard\f0\fs15     % RMSE_Cl = sqrt(mean((CL - Cl_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cd = sqrt(mean((CD - Cd_CFD)^2));\par
\pard\f0\fs15     % RMSE_Cm = sqrt(mean((CM - Cm_CFD)^2));\par
\pard\f0\fs15     % Total_RMSE = RMSE_Cl + RMSE_Cd + RMSE_Cm ;\par
\pard\f0\fs15     % \u21160?\u24577?\u26102?\u-27148?\u-30268?\u25972?\par
\pard\f0\fs15     % \u24402?\u19968?\u21270?\par
\pard\f0\fs15     % norm_cl_cfd = normalize(Cl_CFD);\par
\pard\f0\fs15     % norm_test_cl = normalize(test_Cl);\par
\pard\f0\fs15     % norm_cd_cfd = normalize(Cd_CFD);\par
\pard\f0\fs15     % norm_test_cd = normalize(test_Cd);\par
\pard\f0\fs15     % [x_test_max,y_test_max] = getMaxXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_max,y_CFD_max] = getMaxXY(a0,CN_CFD);\par
\pard\f0\fs15     % [x_test_min,y_test_min] = getMinXY(a_c,test_Cn);\par
\pard\f0\fs15     % [x_CFD_min,y_CFD_min] = getMinXY(a0,CN_CFD);\par
\pard\f0\fs15     % CN_CFD_new = interp1(x_CFD,CN_CFD,x_area,'linear');\par
\pard\f0\fs15     % dmax = (x_test_max-x_CFD_max)^2 + (y_CFD_max-y_test_max)^2;\par
\pard\f0\fs15     % dmin = (x_test_min-x_CFD_min)^2 + (y_CFD_min-y_test_min)^2;\par
\pard\f0\fs15     [dist1,~,~] = dtw(test_Cn,CN_CFD);\par
\pard\f0\fs15     % [dist2,~,~] = dtw(Cd_CFD,test_Cd);\par
\pard\f0\fs15     % [dist3,~,~] = dtw(Cm_CFD,test_Cm);\par
\pard\f0\fs15     %% ===================== 5. \u20445?\u30041?\u25152?\u26377?\u29289?\u29702?\u32422?\u26463?\u24809?\u32602?\u-26503?\u-248?BL\u27169?\u22411?\u30828?\u24615?\u-30335?\u27714?\u-244?\u24517?\u-26501?\u20445?\u30041?\u-247? =====================\par
\pard\f0\fs15     %% ===================== 6. \u24635?\u-28670?\u24212?\u24230?\u20989?\u25968?\u-248?\u-29302?\u23567?\u-29302?\u22909?\u-244?\u23436?\u32654?\u-28670?\u-28339?\u-28709?\u21270?\u31639?\u27861?\u-247? =====================\par
\pard\f0\fs15     % \u26435?\u-28211?\u20998?\u-28339?\u-230?\u-26782?\u31215?\u-29713?\u24046?\u215?10\u-248?\u20027?\u-247? + RMSE\u-248?\u27425?\u-247? + \u24809?\u32602?\u-26503? \u8594? \u20248?\u20808?\u20445?\u-29759?\u-26782?\u31215?\u30456?\u-28719?\u-244?\u20877?\u20445?\u-29759?\u28857?\u-29388?\u21512?\u-244?\u26368?\u21518?\u20445?\u-29759?\u29289?\u29702?\u21512?\u29702?\u24615?\par
\pard\f0\fs15     Fitness = MSE*100;\par
\pard\f0\fs15 %% ===== File: functions/get_a_q.m =====\par
\pard\f0\fs15 function [a,da,q,dq] = get_a_q(Am,A,w,c,U,t)\par
\pard\f0\fs15     a_deg  = Am + A * sin(w * t);\par
\pard\f0\fs15     da_deg = A * w * cos(w * t);\par
\pard\f0\fs15     q_deg  = da_deg * c / U;\par
\pard\f0\fs15     dq_deg = -A * w^2 * c / U * sin(w * t);\par
\pard\f0\fs15     a  = deg2rad(a_deg);\par
\pard\f0\fs15     da = deg2rad(da_deg);\par
\pard\f0\fs15     q  = deg2rad(q_deg);\par
\pard\f0\fs15     dq = deg2rad(dq_deg);\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/get_CFDdata.m =====\par
\pard\f0\fs15 function [a, Cl,Cd,Cm] = get_CFDdata(filename,setcase)\par
\pard\f0\fs15     warning off\par
\pard\f0\fs15     meanangle = setcase.meanangle     ;\par
\pard\f0\fs15     averageangle = setcase.averageangle  ;\par
\pard\f0\fs15     conditions = setcase.conditions    ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata;\par
\pard\f0\fs15     w     = conditions.w;\par
\pard\f0\fs15     c     = airfoildata.c;\par
\pard\f0\fs15     U     = conditions.U;\par
\pard\f0\fs15     T     = 2*pi/w      ;\par
\pard\f0\fs15     cfd_data = readmatrix(filename);\par
\pard\f0\fs15     time   = cfd_data(:,1);\par
\pard\f0\fs15     Cl_ori = cfd_data(:,2);\par
\pard\f0\fs15     Cd_ori = cfd_data(:,3);\par
\pard\f0\fs15     Cm_ori = cfd_data(:,4);\par
\pard\f0\fs15     timestep   = time(3)- time(2);\par
\pard\f0\fs15     a = 3;\par
\pard\f0\fs15     b = 4;\par
\pard\f0\fs15     t_i = a * T / timestep;\par
\pard\f0\fs15     t_j = b * T / timestep;\par
\pard\f0\fs15     a = meanangle - averageangle*sin(w*time(t_i:t_j));\par
\pard\f0\fs15     Cl = Cl_ori(t_i:t_j);\par
\pard\f0\fs15     Cd = Cd_ori(t_i:t_j);\par
\pard\f0\fs15     Cm = Cm_ori(t_i:t_j);\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/getMaxXY.m =====\par
\pard\f0\fs15 function [x_test_max,y_test_max] = getMaxXY(x,y)\par
\pard\f0\fs15     y_test_max = max(y);\par
\pard\f0\fs15     idx = y == y_test_max;\par
\pard\f0\fs15     x_test_max = x(idx);\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/getMinXY.m =====\par
\pard\f0\fs15 function [x_test_min,y_test_min] = getMinXY(x,y)\par
\pard\f0\fs15     y_test_min = min(y);\par
\pard\f0\fs15     idx = y == y_test_min;\par
\pard\f0\fs15     x_test_min = x(idx);\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/input_afdata.m =====\par
\pard\f0\fs15 function airfoildata = input_afdata\par
\pard\f0\fs15     data    = readmatrix('FFA_W3_211.txt');\par
\pard\f0\fs15     c      = 1             ;\par
\pard\f0\fs15     CD0    = 1.5           ;\par
\pard\f0\fs15     CM0    = 0.01          ;\par
\pard\f0\fs15     alpha0 = find_a0(data) ;\par
\pard\f0\fs15     alpha1 = deg2rad(12)   ;\par
\pard\f0\fs15     alpha2 = deg2rad(-10)  ;\par
\pard\f0\fs15     CN1    = 1.7          ;\par
\pard\f0\fs15     CN2    = -1            ;\par
\pard\f0\fs15     slope  = 7 ;\par
\pard\f0\fs15     mCN    = slope         ;\par
\pard\f0\fs15     slope_M= mCN           ;\par
\pard\f0\fs15     xAC  =0.25           ; xcp_c=0.2 ;\par
\pard\f0\fs15     airfoildata.CD0 = CD0;\par
\pard\f0\fs15     airfoildata.CM0 = CM0;\par
\pard\f0\fs15     airfoildata.alpha0 = alpha0;\par
\pard\f0\fs15     airfoildata.alpha1 = alpha1;\par
\pard\f0\fs15     airfoildata.alpha2 = alpha2;\par
\pard\f0\fs15     airfoildata.CN1 = CN1;\par
\pard\f0\fs15     airfoildata.CN2 = CN2;\par
\pard\f0\fs15     airfoildata.slope = slope;\par
\pard\f0\fs15     airfoildata.mCN = mCN;\par
\pard\f0\fs15     airfoildata.slope_M = slope_M;\par
\pard\f0\fs15     airfoildata.c = c;\par
\pard\f0\fs15     airfoildata.xAC = xAC;\par
\pard\f0\fs15     airfoildata.xcp_c = xcp_c;\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/input_condition.m =====\par
\pard\f0\fs15 function conditions = input_condition(meanangle,averageangle)\par
\pard\f0\fs15     Re   = 1e6                       ;%\u-26889?\u-29702?\u25968?\par
\pard\f0\fs15     st   = 0.19                      ;\par
\pard\f0\fs15     miu  = 1.8e-5                    ;%\u31896?\u24230?\par
\pard\f0\fs15     rho  = 1.225                     ;%\u23494?\u24230?\u-244?kg/m3\par
\pard\f0\fs15     c    = 1                         ;%\u21494?\u29255?\u24358?\u-27265?\u-244?m\par
\pard\f0\fs15     as   = 340.3                     ;%\u-32278?\u30001?\u27969?\u22768?\u-28641?\u-244?m/s\par
\pard\f0\fs15     U    = 10  ;%Re*miu/rho/c        ;%\u26469?\u27969?\u-28641?\u24230?\u-244?m/s\par
\pard\f0\fs15     M    = U / as                    ;%\u-26004?\u-29333?\u25968?\par
\pard\f0\fs15     beta = sqrt(1 - M^2)             ;%\u21442?\u25968?\u946?\par
\pard\f0\fs15     ff   = 1                         ;%pitch\u-30254?\u21464?\u21270?\u-26479?\u29575?\par
\pard\f0\fs15     k    = 0.31  ;%pi*ff*c/U          ;%\u32553?\u20943?\u-26479?\u29575?\par
\pard\f0\fs15     w       = 2*k*U/c                ;\par
\pard\f0\fs15     n_T     = 10                     ;\par
\pard\f0\fs15     T       = 2*pi/w*n_T               ;%pitch\u-30254?\u21464?\u21270?\u21608?\u26399?\par
\pard\f0\fs15     n_steps = 5000;\par
\pard\f0\fs15     t       = linspace(0,T,n_steps)     ;%\u-29791?\u31639?\u19968?\u20010?\u21608?\u26399?\u20869?\par
\pard\f0\fs15     s       = 2 * U * t / c             ;%\u26080?\u-28209?\u32434?\u26102?\u-27148?\par
\pard\f0\fs15     ds      = s(2) - s(1)               ;\par
\pard\f0\fs15     dt      = t(2) - t(1)               ;\par
\pard\f0\fs15     Am      = meanangle                       ;%\u25915?\u-30254?\u24179?\u22343?\u20301?\u32622?\u-244?deg\par
\pard\f0\fs15     A       = averageangle                       ;%pitch\u-30254?\u21464?\u21270?\u24133?\u20540?\u-244?deg\par
\pard\f0\fs15     [a,da,q,dq] = get_a_q(Am,-A,w,c,U,t);\par
\pard\f0\fs15     conditions.a = a;\par
\pard\f0\fs15     conditions.da = da;\par
\pard\f0\fs15     conditions.q = q;\par
\pard\f0\fs15     conditions.dq = dq;\par
\pard\f0\fs15     conditions.as = as;\par
\pard\f0\fs15     conditions.beta = beta;\par
\pard\f0\fs15     conditions.n_steps = n_steps;\par
\pard\f0\fs15     conditions.ds = ds;\par
\pard\f0\fs15     conditions.dt = dt;\par
\pard\f0\fs15     conditions.U = U;\par
\pard\f0\fs15     conditions.M = M;\par
\pard\f0\fs15     conditions.s = s;\par
\pard\f0\fs15     conditions.t = t;\par
\pard\f0\fs15     conditions.w = w;\par
\pard\f0\fs15     conditions.ff = ff;\par
\pard\f0\fs15     conditions.k = k;\par
\pard\f0\fs15     conditions.Re = Re;\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/Leishman_exponential_fitting.m =====\par
\pard\f0\fs15 function f = Leishman_exponential_fitting(alpha0,alpha1,alpha2,ae,S1,S2,S3,S4,n_steps)\par
\pard\f0\fs15     for i = 1: length(n_steps)\par
\pard\f0\fs15         if ae <= alpha1 && alpha0 <= ae\par
\pard\f0\fs15             f = 1 - 0.3*exp(rad2deg(ae-alpha1)/S1);\par
\pard\f0\fs15         elseif ae <= alpha0 && alpha2 <= ae\par
\pard\f0\fs15             f = 1 - 0.3*exp(rad2deg(alpha2-ae)/S3);\par
\pard\f0\fs15         elseif ae > alpha1\par
\pard\f0\fs15             f = 0.04 + 0.66*exp(rad2deg(alpha1-ae)/S2);\par
\pard\f0\fs15         elseif ae < alpha2\par
\pard\f0\fs15             f = 0.04 + 0.66*exp(rad2deg(ae-alpha2)/S4);\par
\pard\f0\fs15         end\par
\pard\f0\fs15     end\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/new_areacover.m =====\par
\pard\f0\fs15 function E = new_areacover(ARE_data,DTW_data,GZ_data,init_data,exp_data)\par
\pard\f0\fs15     pg_ARE = polyshape(ARE_data(:,1), ARE_data(:,2));\par
\pard\f0\fs15     pg_DTW = polyshape(DTW_data(:,1), DTW_data(:,2));\par
\pard\f0\fs15     pg_GZ = polyshape(GZ_data(:,1), GZ_data(:,2));\par
\pard\f0\fs15     pg_init = polyshape(init_data(:,1), init_data(:,2));\par
\pard\f0\fs15     pg_exp = polyshape(exp_data(:,1), exp_data(:,2));\par
\pard\f0\fs15     pg_ARE = intersect(pg_exp, pg_ARE);\par
\pard\f0\fs15     pg_DTW = intersect(pg_exp, pg_DTW);\par
\pard\f0\fs15     pg_GZ = intersect(pg_exp, pg_GZ);\par
\pard\f0\fs15     pg_init = intersect(pg_exp, pg_init);\par
\pard\f0\fs15     A_ARE = area(pg_ARE);\par
\pard\f0\fs15     A_DTW = area(pg_DTW);\par
\pard\f0\fs15     A_GZ = area(pg_GZ);\par
\pard\f0\fs15     A_init = area(pg_init);\par
\pard\f0\fs15     A_exp = area(pg_exp);\par
\pard\f0\fs15     S_ARE = A_ARE/A_exp;\par
\pard\f0\fs15     S_DTW = A_DTW/A_exp;\par
\pard\f0\fs15     S_GZ = A_GZ/A_exp;\par
\pard\f0\fs15     S_init = A_init/A_exp;\par
\pard\f0\fs15     E = [S_ARE S_DTW S_GZ S_init];\par
\pard\f0\fs15     % figure;\par
\pard\f0\fs15     % plot(pg1, 'FaceColor', 'red', 'FaceAlpha', 0.3);\par
\pard\f0\fs15     % hold on;\par
\pard\f0\fs15     % plot(pg2, 'FaceColor', 'blue', 'FaceAlpha', 0.3);\par
\pard\f0\fs15     % plot(pg_inter, 'FaceColor', 'green', 'FaceAlpha', 0.6);\par
\pard\f0\fs15     % ylim([0 2])\par
\pard\f0\fs15     % axis equal;\par
\pard\f0\fs15     % legend('DTW\u21306?\u22495?', 'exp\u21306?\u22495?', '\u20132?\u-26938?\u21306?\u22495?');\par
\pard\f0\fs15     % title(['\u20132?\u-26938?\u-26782?\u31215? = ', num2str(A_inter)]);\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/process_mat_data.m =====\par
\pard\f0\fs15 function Error_S = process_mat_data(S_ARE,S_DTW,S_GZ,S_init,S_exp)\par
\pard\f0\fs15     error_ARE = sqrt(sum((S_ARE-S_exp).^2));\par
\pard\f0\fs15     error_DTW = sqrt(sum((S_DTW-S_exp).^2));\par
\pard\f0\fs15     error_GZ = sqrt(sum((S_GZ-S_exp).^2));\par
\pard\f0\fs15     error_init = sqrt(sum((S_init-S_exp).^2));\par
\pard\f0\fs15     Error_S= [error_ARE error_DTW error_GZ error_init];\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/readoutfile.m =====\par
\pard\f0\fs15 function data = readoutfile(filename)\par
\pard\f0\fs15     data = readmatrix(filename, 'FileType', 'text', 'Range', 'A4');\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/reshape_data.m =====\par
\pard\f0\fs15 function [up,dw] = reshape_data(data)\par
\pard\f0\fs15     up_1 = [];\par
\pard\f0\fs15     up_2 = [];\par
\pard\f0\fs15     dw = [];\par
\pard\f0\fs15     turn = 0 ;\par
\pard\f0\fs15     for j = 1 : length(data(:,1))\par
\pard\f0\fs15         if j < length(data(:,1))\par
\pard\f0\fs15             if data(j+1,1) > data(j,1)\par
\pard\f0\fs15                 if turn == 0\par
\pard\f0\fs15                     up_1 = [up_1;[data(j,1) data(j,2)]];\par
\pard\f0\fs15                 end\par
\pard\f0\fs15                 if turn == 1\par
\pard\f0\fs15                     up_2 = [up_2;[data(j,1) data(j,2)]];\par
\pard\f0\fs15                 end\par
\pard\f0\fs15             else\par
\pard\f0\fs15                 turn = 1;\par
\pard\f0\fs15                 dw = [dw;[data(j,1) data(j,2)]];\par
\pard\f0\fs15             end\par
\pard\f0\fs15         else\par
\pard\f0\fs15             up_2 = [up_2;[data(j,1) data(j,2)]];\par
\pard\f0\fs15         end\par
\pard\f0\fs15     end\par
\pard\f0\fs15     up = [up_2;up_1];\par
\pard\f0\fs15     % figure\par
\pard\f0\fs15     % plot(up(:,1), up(:,2))\par
\pard\f0\fs15     % hold on\par
\pard\f0\fs15     % plot(dw(:,1), dw(:,2))\par
\pard\f0\fs15     % legend('up','dw')\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/reshape_expdata.m =====\par
\pard\f0\fs15 function [final_up,final_dw] = reshape_expdata(data)\par
\pard\f0\fs15     l = 250;\par
\pard\f0\fs15     up_1 = [];\par
\pard\f0\fs15     up_2 = [];\par
\pard\f0\fs15     dw = [];\par
\pard\f0\fs15     turn = 0 ;\par
\pard\f0\fs15     for j = 1 : length(data(:,1))\par
\pard\f0\fs15         if j < length(data(:,1))\par
\pard\f0\fs15             if data(j+1,1) > data(j,1)\par
\pard\f0\fs15                 if turn == 0\par
\pard\f0\fs15                     up_1 = [up_1;[data(j,1) data(j,2)]];\par
\pard\f0\fs15                 end\par
\pard\f0\fs15                 if turn == 1\par
\pard\f0\fs15                     up_2 = [up_2;[data(j,1) data(j,2)]];\par
\pard\f0\fs15                 end\par
\pard\f0\fs15             else\par
\pard\f0\fs15                 turn = 1;\par
\pard\f0\fs15                 dw = [dw;[data(j,1) data(j,2)]];\par
\pard\f0\fs15             end\par
\pard\f0\fs15         else\par
\pard\f0\fs15             up_2 = [up_2;[data(j,1) data(j,2)]];\par
\pard\f0\fs15         end\par
\pard\f0\fs15     end\par
\pard\f0\fs15     up = [up_2;up_1];\par
\pard\f0\fs15     v_up = linspace(min(up(:,1)),max(up(:,1)),l);\par
\pard\f0\fs15     v_dw = linspace(max(up(:,1)),min(up(:,1)),l);\par
\pard\f0\fs15     up_interp = interp1(up(:,1),v_up);\par
\pard\f0\fs15     dw_interp = interp1(dw(:,1),v_dw);\par
\pard\f0\fs15     up_data = interp1(up(:,1),up(:,2),v_up,'linear','extrap');\par
\pard\f0\fs15     dw_data = interp1(dw(:,1),dw(:,2),v_dw,'linear','extrap');\par
\pard\f0\fs15     final_up = [v_up' up_data'];\par
\pard\f0\fs15     final_dw = [v_dw' dw_data'];\par
\pard\f0\fs15     % figure\par
\pard\f0\fs15     % plot(final_up(:,1), final_up(:,2))\par
\pard\f0\fs15     % hold on\par
\pard\f0\fs15     % plot(final_dw(:,1), final_dw(:,2))\par
\pard\f0\fs15     % legend('up','dw')\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/run_optimal.m =====\par
\pard\f0\fs15 function para_local = run_optimal(para_init,Npara,lb,ub,setcase)\par
\pard\f0\fs15     % 4. \u30446?\u26631?\u20989?\u25968?\par
\pard\f0\fs15     fitnessFcn = @(param) fitness(param,setcase);\par
\pard\f0\fs15     initial_fitness = fitness(para_init,setcase);\par
\pard\f0\fs15     nonlcon = @(param) fitness_constraint(param, initial_fitness,setcase);\par
\pard\f0\fs15     % 5. \u20840?\u23616?\u20248?\u21270?\u-244?\u-28585?\u20256?\u31639?\u27861?\u-28339?\u32622?\par
\pard\f0\fs15     globaloptions = optimoptions('ga',    ...\par
\pard\f0\fs15         'PopulationSize', 128,      ...     % \u31181?\u32676?\u-30268?\u27169?\par
\pard\f0\fs15         'MaxGenerations', 50,      ...     % \u-28691?\u20195?\u27425?\u25968?\par
\pard\f0\fs15         'FunctionTolerance',1e-6,   ...\par
\pard\f0\fs15         'ConstraintTolerance',1e-6, ...\par
\pard\f0\fs15         'PlotFcn','gaplotrange',    ...     % \u25910?\u25947?\u26354?\u32447?\u21487?\u-30266?\u21270?\par
\pard\f0\fs15         'Display','iter',           ...\par
\pard\f0\fs15         'InitialPopulationMatrix', para_init, ...\par
\pard\f0\fs15         'UseParallel',true);\par
\pard\f0\fs15     % 6. \u-28720?\u-30644?\u-28709?\u21270?\u31639?\u27861?\u23547?\u20248?\par
\pard\f0\fs15     fprintf('===== \u21160?\u24577?\u22833?\u-28641?BL\u27169?\u22411?\u21442?\u25968?\u20248?\u21270?\u24320?\u22987?\u12304?CFD\u25311?\u21512?+\u-26782?\u31215?\u30456?\u20284?\u24230?\u12305? =====\\n');\par
\pard\f0\fs15     [para_global, fitness_opt] = ga(fitnessFcn, Npara, [], [], [], [], lb, ub, nonlcon, globaloptions);\par
\pard\f0\fs15     fprintf('===== \u20248?\u21270?\u23436?\u25104?\u-255?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.8f =====\\n', fitness_opt);\par
\pard\f0\fs15     % 7. \u23616?\u-28440?\u20248?\u21270?\par
\pard\f0\fs15     fminconOpts = optimoptions('fmincon', ...\par
\pard\f0\fs15         'Algorithm', 'interior-point', ...\par
\pard\f0\fs15         'Display', 'iter', ...\par
\pard\f0\fs15         'MaxFunctionEvaluations', 50, ...\par
\pard\f0\fs15         'OptimalityTolerance', 1e-4, ...\par
\pard\f0\fs15         'StepTolerance', 1e-4,...\par
\pard\f0\fs15         'PlotFcn','optimplotfirstorderopt',...\par
\pard\f0\fs15         'UseParallel',true);\par
\pard\f0\fs15     % 8. \u-28720?\u-30644?\u23616?\u-28440?\u26368?\u20248?\u21270?\par
\pard\f0\fs15     fprintf('===== fmincon \u23616?\u-28440?\u20248?\u21270?\u24320?\u22987? =====\\n');\par
\pard\f0\fs15     para1 = para_global;  % \u20351?\u29992? GA \u30340?\u26368?\u20248?\u-30237?\u20316?\u20026?\u21021?\u22987?\u20540?\par
\pard\f0\fs15     [para_local, f_opt] = fmincon(fitnessFcn, para1, [], [], [], [], lb, ub, nonlcon, fminconOpts);\par
\pard\f0\fs15     fprintf('===== \u23616?\u-28440?\u20248?\u21270?\u23436?\u25104?\u-230?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.10f =====\\n', f_opt);\par
\pard\f0\fs15     % 7. \u32467?\u26524?\u-28781?\u20986?+\u20445?\u23384?\par
\pard\f0\fs15     para_label = \{'A3','b3','A4','b4','A5','b5','k0','k1','k2','k3'\};\par
\pard\f0\fs15     fprintf('\\n==================== \u21407?\u22987?\u21442?\u25968? \u8596? \u20248?\u21270?\u21518?\u26368?\u20248?\u21442?\u25968? \u23545?\u27604?\u-30616? ====================\\n');\par
\pard\f0\fs15     fprintf('\u21407?\u22987?\u-28670?\u24212?\u24230?=%.6f | \u20248?\u21270?\u-28670?\u24212?\u24230?=%.6f\\n', fitness(para_init,setcase), fitness(para_local,setcase));\par
\pard\f0\fs15     for i = 1:Npara\par
\pard\f0\fs15         fprintf('%5s : \u21407?\u22987?\u20540?=%.6f | \u20248?\u21270?\u20540?=%.6f\\n', para_label\{i\}, para_init(i), para_local(i));\par
\pard\f0\fs15     end\par
\pard\f0\fs15     [A3,b3,A4,b4,A5,b5,k0,k1,k2,k3] = deal(para_local(:));\par
\pard\f0\fs15     save('BL\u27169?\u22411?_CFD\u25311?\u21512?_\u26368?\u32456?\u20248?\u21270?\u21442?\u25968?.mat','para_local','fitness_opt');\par
\pard\f0\fs15     fprintf('\\n\u20248?\u21270?\u32467?\u26524?\u24050?\u20445?\u23384?\u-32269?\u-230?BL\u27169?\u22411?_CFD\u25311?\u21512?_\u26368?\u32456?\u20248?\u21270?\u21442?\u25968?.mat\\n');\par
\pard\f0\fs15     toc\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/run_optimal_1lag.m =====\par
\pard\f0\fs15 function para_local_lag = run_optimal_1lag(para_init_lag,para_init_cl,para_init_cm,Npara_lag,lb_lag,ub_lag,setcase)\par
\pard\f0\fs15     tic\par
\pard\f0\fs15     % 4. \u30446?\u26631?\u20989?\u25968?\par
\pard\f0\fs15     fitnessFcn = @(para) fitness_lag(para,para_init_cl,para_init_cm,setcase);\par
\pard\f0\fs15     initial_fitness    = fitness_lag(para_init_lag,para_init_cl,para_init_cm,setcase);\par
\pard\f0\fs15     nonlcon = @(para)  fitness_constraint_lag(para,para_init_cl,para_init_cm, initial_fitness,setcase);\par
\pard\f0\fs15     % 5. \u20840?\u23616?\u20248?\u21270?\u-244?\u-28585?\u20256?\u31639?\u27861?\u-28339?\u32622?\par
\pard\f0\fs15     globaloptions = optimoptions('ga',    ...\par
\pard\f0\fs15         'PopulationSize', 256,      ...     % \u31181?\u32676?\u-30268?\u27169?\par
\pard\f0\fs15         'MaxGenerations', 10,      ...     % \u-28691?\u20195?\u27425?\u25968?\par
\pard\f0\fs15         'FunctionTolerance',1e-3,   ...\par
\pard\f0\fs15         'ConstraintTolerance',1e-3, ...\par
\pard\f0\fs15         'Display','iter',           ...\par
\pard\f0\fs15         'InitialPopulationMatrix', para_init_lag, ...\par
\pard\f0\fs15         'UseParallel',true);\par
\pard\f0\fs15     % 6. \u-28720?\u-30644?\u-28709?\u21270?\u31639?\u27861?\u23547?\u20248?\par
\pard\f0\fs15     fprintf('===== \u21160?\u24577?\u22833?\u-28641?BL\u27169?\u22411?\u21442?\u25968?\u20248?\u21270?\u24320?\u22987?\u12304?CFD\u25311?\u21512?+\u-26782?\u31215?\u30456?\u20284?\u24230?\u12305? =====\\n');\par
\pard\f0\fs15     [para_local_lag, fitness_opt] = ga(fitnessFcn, Npara_lag, [], [], [], [], lb_lag, ub_lag, nonlcon, globaloptions);\par
\pard\f0\fs15     fprintf('===== \u20248?\u21270?\u23436?\u25104?\u-255?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.8f =====\\n', fitness_opt);\par
\pard\f0\fs15     % % 7. \u23616?\u-28440?\u20248?\u21270?\par
\pard\f0\fs15     % fminconOpts = optimoptions('fmincon', ...\par
\pard\f0\fs15     %     'Algorithm', 'sqp', ...\par
\pard\f0\fs15     %     'Display', 'iter', ...\par
\pard\f0\fs15     %     'MaxFunctionEvaluations', 50, ...\par
\pard\f0\fs15     %     'OptimalityTolerance', 1e-8, ...\par
\pard\f0\fs15     %     'StepTolerance', 1e-10,...\par
\pard\f0\fs15     %     'UseParallel',true);\par
\pard\f0\fs15     %\par
\pard\f0\fs15     % % 8. \u-28720?\u-30644?\u23616?\u-28440?\u26368?\u20248?\u21270?\par
\pard\f0\fs15     % fprintf('===== fmincon \u23616?\u-28440?\u20248?\u21270?\u24320?\u22987? =====\\n');\par
\pard\f0\fs15     % para1 = para_global;  % \u20351?\u29992? GA \u30340?\u26368?\u20248?\u-30237?\u20316?\u20026?\u21021?\u22987?\u20540?\par
\pard\f0\fs15     % [para_local, f_opt] = fmincon(fitnessFcn, para1, [], [], [], [], lb, ub, nonlcon, fminconOpts);\par
\pard\f0\fs15     % fprintf('===== \u23616?\u-28440?\u20248?\u21270?\u23436?\u25104?\u-230?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.10f =====\\n', f_opt);\par
\pard\f0\fs15     % 7. \u32467?\u26524?\u-28781?\u20986?+\u20445?\u23384?\par
\pard\f0\fs15     para_label = \{'S1','S2','S3','S4'\};\par
\pard\f0\fs15     fprintf('\\n==================== \u21407?\u22987?\u21442?\u25968? \u8596? \u20248?\u21270?\u21518?\u26368?\u20248?\u21442?\u25968? \u23545?\u27604?\u-30616? ====================\\n');\par
\pard\f0\fs15     fprintf('\u21407?\u22987?\u-28670?\u24212?\u24230?=%.6f | \u20248?\u21270?\u-28670?\u24212?\u24230?=%.6f\\n', fitness_lag(para_init_lag,para_init_cl,para_init_cm,setcase), fitness_lag(para_local_lag,para_init_cl,para_init_cm,setcase));\par
\pard\f0\fs15     for i = 1:Npara_lag\par
\pard\f0\fs15         fprintf('%5s : \u21407?\u22987?\u20540?=%.6f | \u20248?\u21270?\u20540?=%.6f\\n', para_label\{i\}, para_init_lag(i), para_local_lag(i));\par
\pard\f0\fs15     end\par
\pard\f0\fs15     [S1,S2,S3,S4] = deal(para_local_lag(1:4));\par
\pard\f0\fs15     save('Boundary_layer_fitness.mat','para_local_lag','fitness_opt');\par
\pard\f0\fs15     fprintf('\\n\u20248?\u21270?\u32467?\u26524?\u24050?\u20445?\u23384?\u-32269?\u-230?Boundary_layer_fitness.mat\\n');\par
\pard\f0\fs15     toc\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/run_optimal_2cl.m =====\par
\pard\f0\fs15 function para_local_cl = run_optimal_2cl(para_local_lag,para_init_cl,para_init_cm,Npara_cl,lb_cl,ub_cl,setcase)\par
\pard\f0\fs15     tic\par
\pard\f0\fs15     % 4. \u30446?\u26631?\u20989?\u25968?\par
\pard\f0\fs15     fitnessFcn = @(param) fitness_cl(para_local_lag,param,para_init_cm,setcase);\par
\pard\f0\fs15     initial_fitness     = fitness_cl(para_local_lag,para_init_cl,para_init_cm,setcase);\par
\pard\f0\fs15     nonlcon = @(param) fitness_constraint_cl(para_local_lag, param, para_init_cm, initial_fitness,setcase);\par
\pard\f0\fs15     % 5. \u20840?\u23616?\u20248?\u21270?\u-244?\u-28585?\u20256?\u31639?\u27861?\u-28339?\u32622?\par
\pard\f0\fs15     globaloptions = optimoptions('ga',    ...\par
\pard\f0\fs15         'PopulationSize', 256,      ...     % \u31181?\u32676?\u-30268?\u27169?\par
\pard\f0\fs15         'MaxGenerations', 10,      ...     % \u-28691?\u20195?\u27425?\u25968?\par
\pard\f0\fs15         'FunctionTolerance',1e-3,   ...\par
\pard\f0\fs15         'ConstraintTolerance',1e-3, ...\par
\pard\f0\fs15         'Display','iter',           ...\par
\pard\f0\fs15         'InitialPopulationMatrix', para_init_cl, ...\par
\pard\f0\fs15         'UseParallel',true);\par
\pard\f0\fs15     % 6. \u-28720?\u-30644?\u-28709?\u21270?\u31639?\u27861?\u23547?\u20248?\par
\pard\f0\fs15     fprintf('===== \u21160?\u24577?\u22833?\u-28641?BL\u27169?\u22411?\u21442?\u25968?\u20248?\u21270?\u24320?\u22987?\u12304?CFD\u25311?\u21512?+\u-26782?\u31215?\u30456?\u20284?\u24230?\u12305? =====\\n');\par
\pard\f0\fs15     [para_local_cl, fitness_opt] = ga(fitnessFcn, Npara_cl, [], [], [], [], lb_cl, ub_cl, nonlcon, globaloptions);\par
\pard\f0\fs15     fprintf('===== \u20248?\u21270?\u23436?\u25104?\u-255?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.8f =====\\n', fitness_opt);\par
\pard\f0\fs15     % % 7. \u23616?\u-28440?\u20248?\u21270?\par
\pard\f0\fs15     % fminconOpts = optimoptions('fmincon', ...\par
\pard\f0\fs15     %     'Algorithm', 'sqp', ...\par
\pard\f0\fs15     %     'Display', 'iter', ...\par
\pard\f0\fs15     %     'MaxFunctionEvaluations', 50, ...\par
\pard\f0\fs15     %     'OptimalityTolerance', 1e-8, ...\par
\pard\f0\fs15     %     'StepTolerance', 1e-10,...\par
\pard\f0\fs15     %     'UseParallel',true);\par
\pard\f0\fs15     %\par
\pard\f0\fs15     % % 8. \u-28720?\u-30644?\u23616?\u-28440?\u26368?\u20248?\u21270?\par
\pard\f0\fs15     % fprintf('===== fmincon \u23616?\u-28440?\u20248?\u21270?\u24320?\u22987? =====\\n');\par
\pard\f0\fs15     % para1 = para_global;  % \u20351?\u29992? GA \u30340?\u26368?\u20248?\u-30237?\u20316?\u20026?\u21021?\u22987?\u20540?\par
\pard\f0\fs15     % [para_local, f_opt] = fmincon(fitnessFcn, para1, [], [], [], [], lb, ub, nonlcon, fminconOpts);\par
\pard\f0\fs15     % fprintf('===== \u23616?\u-28440?\u20248?\u21270?\u23436?\u25104?\u-230?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.10f =====\\n', f_opt);\par
\pard\f0\fs15     % 7. \u32467?\u26524?\u-28781?\u20986?+\u20445?\u23384?\par
\pard\f0\fs15     para_label = \{'A1','b1','A2','b2','Tp','Tf0','Tvl','Tv0','yita'\};\par
\pard\f0\fs15     fprintf('\\n==================== \u21407?\u22987?\u21442?\u25968? \u8596? \u20248?\u21270?\u21518?\u26368?\u20248?\u21442?\u25968? \u23545?\u27604?\u-30616? ====================\\n');\par
\pard\f0\fs15     fprintf('\u21407?\u22987?\u-28670?\u24212?\u24230?=%.6f | \u20248?\u21270?\u-28670?\u24212?\u24230?=%.6f\\n', fitness_cl(para_local_lag,para_init_cl,para_init_cm,setcase), fitness_cl(para_local_lag, para_local_cl, para_init_cm, setcase));\par
\pard\f0\fs15     for i = 1:Npara_cl\par
\pard\f0\fs15         fprintf('%5s : \u21407?\u22987?\u20540?=%.6f | \u20248?\u21270?\u20540?=%.6f\\n', para_label\{i\}, para_init_cl(i), para_local_cl(i));\par
\pard\f0\fs15     end\par
\pard\f0\fs15     [A1,b1,A2,b2,Tp,Tf0,Tvl,Tv0,yita] = deal(para_local_cl(:));\par
\pard\f0\fs15     save('param_cl.mat','para_local_cl','fitness_opt');\par
\pard\f0\fs15     fprintf('\\n\u20248?\u21270?\u32467?\u26524?\u24050?\u20445?\u23384?\u-32269?\u-230?param_cl.mat\\n');\par
\pard\f0\fs15     toc\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/run_optimal_3cm.m =====\par
\pard\f0\fs15 function para_local_cm = run_optimal_3cm(para_local_lag,para_local_cl,para_init_cm,Npara_cm,lb_cm,ub_cm,setcase)\par
\pard\f0\fs15     tic\par
\pard\f0\fs15     % 4. \u30446?\u26631?\u20989?\u25968?\par
\pard\f0\fs15     fitnessFcn = @(para) fitness_cm(para_local_lag,para_local_cl,para,setcase);\par
\pard\f0\fs15     initial_fitness    = fitness_cm(para_local_lag,para_local_cl,para_init_cm,setcase);\par
\pard\f0\fs15     nonlcon = @(para)  fitness_constraint_cm(para_local_lag,para_local_cl,para, initial_fitness,setcase);\par
\pard\f0\fs15     % 5. \u20840?\u23616?\u20248?\u21270?\u-244?\u-28585?\u20256?\u31639?\u27861?\u-28339?\u32622?\par
\pard\f0\fs15     globaloptions = optimoptions('ga',    ...\par
\pard\f0\fs15         'PopulationSize', 256,      ...     % \u31181?\u32676?\u-30268?\u27169?\par
\pard\f0\fs15         'MaxGenerations', 10,      ...     % \u-28691?\u20195?\u27425?\u25968?\par
\pard\f0\fs15         'FunctionTolerance',1e-3,   ...\par
\pard\f0\fs15         'ConstraintTolerance',1e-3, ...\par
\pard\f0\fs15         'Display','iter',           ...\par
\pard\f0\fs15         'InitialPopulationMatrix', para_init_cm, ...\par
\pard\f0\fs15         'UseParallel',true);\par
\pard\f0\fs15     % 6. \u-28720?\u-30644?\u-28709?\u21270?\u31639?\u27861?\u23547?\u20248?\par
\pard\f0\fs15     fprintf('===== \u21160?\u24577?\u22833?\u-28641?BL\u27169?\u22411?\u21442?\u25968?\u20248?\u21270?\u24320?\u22987?\u12304?CFD\u25311?\u21512?+\u-26782?\u31215?\u30456?\u20284?\u24230?\u12305? =====\\n');\par
\pard\f0\fs15     [para_local_cm, fitness_opt] = ga(fitnessFcn, Npara_cm, [], [], [], [], lb_cm, ub_cm, nonlcon, globaloptions);\par
\pard\f0\fs15     fprintf('===== \u20248?\u21270?\u23436?\u25104?\u-255?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.8f =====\\n', fitness_opt);\par
\pard\f0\fs15     % % 7. \u23616?\u-28440?\u20248?\u21270?\par
\pard\f0\fs15     % fminconOpts = optimoptions('fmincon', ...\par
\pard\f0\fs15     %     'Algorithm', 'sqp', ...\par
\pard\f0\fs15     %     'Display', 'iter', ...\par
\pard\f0\fs15     %     'MaxFunctionEvaluations', 50, ...\par
\pard\f0\fs15     %     'OptimalityTolerance', 1e-8, ...\par
\pard\f0\fs15     %     'StepTolerance', 1e-10,...\par
\pard\f0\fs15     %     'UseParallel',true);\par
\pard\f0\fs15     %\par
\pard\f0\fs15     % % 8. \u-28720?\u-30644?\u23616?\u-28440?\u26368?\u20248?\u21270?\par
\pard\f0\fs15     % fprintf('===== fmincon \u23616?\u-28440?\u20248?\u21270?\u24320?\u22987? =====\\n');\par
\pard\f0\fs15     % para1 = para_global;  % \u20351?\u29992? GA \u30340?\u26368?\u20248?\u-30237?\u20316?\u20026?\u21021?\u22987?\u20540?\par
\pard\f0\fs15     % [para_local, f_opt] = fmincon(fitnessFcn, para1, [], [], [], [], lb, ub, nonlcon, fminconOpts);\par
\pard\f0\fs15     % fprintf('===== \u23616?\u-28440?\u20248?\u21270?\u23436?\u25104?\u-230?\u26368?\u20248?\u-28670?\u24212?\u24230?\u20540? = %.10f =====\\n', f_opt);\par
\pard\f0\fs15     % 7. \u32467?\u26524?\u-28781?\u20986?+\u20445?\u23384?\par
\pard\f0\fs15     para_label = \{'A3','b3','A4','b4','A5','b5','k0','k1','k2','k3','xcp'\};\par
\pard\f0\fs15     fprintf('\\n==================== \u21407?\u22987?\u21442?\u25968? \u8596? \u20248?\u21270?\u21518?\u26368?\u20248?\u21442?\u25968? \u23545?\u27604?\u-30616? ====================\\n');\par
\pard\f0\fs15     fprintf('\u21407?\u22987?\u-28670?\u24212?\u24230?=%.6f | \u20248?\u21270?\u-28670?\u24212?\u24230?=%.6f\\n', fitness_cm(para_local_lag,para_local_cl,para_init_cm,setcase), fitness_cm(para_local_lag,para_local_cl,para_local_cm,setcase));\par
\pard\f0\fs15     for i = 1:Npara_cm\par
\pard\f0\fs15         fprintf('%5s : \u21407?\u22987?\u20540?=%.6f | \u20248?\u21270?\u20540?=%.6f\\n', para_label\{i\}, para_init_cm(i), para_local_cm(i));\par
\pard\f0\fs15     end\par
\pard\f0\fs15     [A3,b3,A4,b4,A5,b5,k0,k1,k2,k3,xcp] = deal(para_local_cm(:));\par
\pard\f0\fs15     save('parameters_cm.mat','para_local_cm','fitness_opt');\par
\pard\f0\fs15     fprintf('\\n\u20248?\u21270?\u32467?\u26524?\u24050?\u20445?\u23384?\u-32269?\u-230?parameters_cm.mat\\n');\par
\pard\f0\fs15     toc\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/select_Tf.m =====\par
\pard\f0\fs15 function Tf = select_Tf(TESF,f_lagi_1,LESFi,VRTXi,d_alphai,alphai,alpha0,Tf0,tau_vi,Tvl)\par
\pard\f0\fs15     Tf = Tf0;\par
\pard\f0\fs15     if TESF == 1\par
\pard\f0\fs15         if d_alphai*(alphai-alpha0)<0\par
\pard\f0\fs15             Tf = Tf0 / 2;\par
\pard\f0\fs15         elseif LESFi == -1\par
\pard\f0\fs15             Tf = Tf0;\par
\pard\f0\fs15         elseif f_lagi_1 < 0.7\par
\pard\f0\fs15             Tf = Tf0 / 2;\par
\pard\f0\fs15         else\par
\pard\f0\fs15             Tf = Tf0 / 1.75;\par
\pard\f0\fs15         end\par
\pard\f0\fs15     else\par
\pard\f0\fs15         if LESFi == -1\par
\pard\f0\fs15             Tf = Tf0 / 0.5;\par
\pard\f0\fs15         end\par
\pard\f0\fs15         if VRTXi == 1 && tau_vi < Tvl && tau_vi > 0\par
\pard\f0\fs15             Tf = Tf0 / 0.25;\par
\pard\f0\fs15         end\par
\pard\f0\fs15         if d_alphai*(alphai-alpha0) > 0\par
\pard\f0\fs15             Tf = Tf0 / 0.75;\par
\pard\f0\fs15         end\par
\pard\f0\fs15     end\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/select_Tv.m =====\par
\pard\f0\fs15 function Tv = select_Tv(tau_v,Tvl,TESF,VRTX,d_alphai,alphai,alpha0,q_doti,Tv0)\par
\pard\f0\fs15     Tv = Tv0 / 1;\par
\pard\f0\fs15     if tau_v <= 2*Tvl && tau_v >= Tvl\par
\pard\f0\fs15         Tv = Tv0 / 3;\par
\pard\f0\fs15         if TESF == -1\par
\pard\f0\fs15             Tv = Tv0 / 4;\par
\pard\f0\fs15             if VRTX == 1 && 0 <= tau_v && tau_v <= Tvl\par
\pard\f0\fs15                 if d_alphai*(alphai - alpha0) <0\par
\pard\f0\fs15                     Tv = Tv0/2;\par
\pard\f0\fs15                 else\par
\pard\f0\fs15                     Tv = Tv0;\par
\pard\f0\fs15                 end\par
\pard\f0\fs15             end\par
\pard\f0\fs15         end\par
\pard\f0\fs15     elseif d_alphai*(alphai - alpha0) <0\par
\pard\f0\fs15         Tv = Tv0/4;\par
\pard\f0\fs15     end\par
\pard\f0\fs15     if TESF == -1 && q_doti*(alphai - alpha0)<0\par
\pard\f0\fs15         Tv = Tv0;\par
\pard\f0\fs15     end\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/transfer_cof.m =====\par
\pard\f0\fs15 function [Cn , Ct] = transfer_cof(data)\par
\pard\f0\fs15     a     = data(:,1)*pi/180;\par
\pard\f0\fs15     cl    = data(:,2);\par
\pard\f0\fs15     cd    = data(:,3);\par
\pard\f0\fs15     Cn = zeros(length(a),1);\par
\pard\f0\fs15     Ct = zeros(length(a),1);\par
\pard\f0\fs15     for i = 1 : length(a)\par
\pard\f0\fs15         cn = cd(i) * sin(a(i)) + cl(i) * cos(a(i));\par
\pard\f0\fs15         ct = cl(i) * sin(a(i)) - cd(i) * cos(a(i));\par
\pard\f0\fs15         Cn(i) = cn;\par
\pard\f0\fs15         Ct(i) = ct;\par
\pard\f0\fs15     end\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== File: functions/Vlift.m =====\par
\pard\f0\fs15 function Vlift(start,n_steps,ds,Tv0,CN_V,Cv)\par
\pard\f0\fs15     if start == 2\par
\pard\f0\fs15         CN_V(start-1) = Cv(start-1)*exp(-2*ds/Tv0);\par
\pard\f0\fs15     end\par
\pard\f0\fs15     for i = start : n_steps\par
\pard\f0\fs15         CN_V(i) = CN_V(i) + CN_V(i-1)*exp(-2*ds/Tv0);\par
\pard\f0\fs15     end\par
\pard\f0\fs15 end\par
\pard\f0\fs15 %% ===== End of source code, nonblank source lines: 3237 =====\par
}