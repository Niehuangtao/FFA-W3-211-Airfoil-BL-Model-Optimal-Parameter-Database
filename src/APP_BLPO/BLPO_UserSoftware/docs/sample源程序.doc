\pard\f0\fs15 %% ===== File: functions/compare_optimal_result_cl.m =====\par
\pard\f0\fs15 function compare_optimal_result_cl(para_local_lag, para_init_cl, para_init_cm, para_local_cl, setcase)\par
\pard\f0\fs15     conditions = setcase.conditions ;\par
\pard\f0\fs15     airfoildata = setcase.airfoldata  ;\par
\pard\f0\fs15     CFDdatapath = setcase.CFDdatapath ;\par
\pard\f0\fs15     %% ===================== 2. \u-29791?\u31639?BL\u27169?\u22411?\u30340?\u-28781?\u20986?\u20540? Cl_BL / Cm_BL =====================\par
\pard\f0\fs15     para_local = [para_local_lag, para_local_cl, para_init_cm];\par
\pard\f0\fs15     para_init  = [para_local_lag, para_init_cl, para_init_cm];\par
\pard\f0\fs15     [CC_total,CN_total,CM_total,CD,CL,CM,a] = cal_DS(para_local,conditions,airfoildata);\par
\pard\f0\fs15     [CC_init,CN_init,CM_init,CD_init,CL_init,CM_init,a_init] = cal_DS(para_init,conditions,airfoildata);\par
\pard\f0\fs15     % CFD\u25968?\u25454?\par
\pard\f0\fs15     [a0, cl,cd,cm] = get_CFDdata(CFDdatapath,setcase);\par
\pard\f0\fs15     x_area = linspace(1,length(cl),500);\par
\pard\f0\fs15     x_CFD  = linspace(1,length(cl),length(cl));\par
\pard\f0\fs15     cl = interp1(x_CFD,cl,x_area,'linear');\par
\pard\f0\fs15     w       = conditions.w;\par
\pard\f0\fs15     dt      = conditions.dt;\par
\pard\f0\fs15     start = 7;\par
\pard\f0\fs15     last  = 8;\par
\pard\f0\fs15     idx_s = 2*pi/w*start/dt;\par
\pard\f0\fs15     idx_l = 2*pi/w*last/dt;\par
\pard\f0\fs15     figure\par
\pard\f0\fs15     dtw(cl,CL(idx_s:idx_l))\par
\pard\f0\fs15     figure\par
\pard\f0\fs15     dtw(cl,CL(idx_s:idx_l))\par
\pard\f0\fs15     figure\par
\pard\f0\fs15     plot(CL_init(idx_s:idx_l))\par
\pard\f0\fs15     hold on\par
\pard\f0\fs15     plot(CL(idx_s:idx_l))\par
\pard\f0\fs15     plot(cl)\par
\pard\f0\fs15     legend('\u21021?\u22987?\u20540?\u26354?\u32447?','\u20248?\u21270?\u21518?','CFD')\par
